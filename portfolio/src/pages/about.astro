---
import { getEmDashEntry, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const {
  entry: page,
  error,
  cacheHint,
} = await getEmDashEntry("pages", "about");
if (error) return new Response("Could not load the page", { status: 500 });
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(page, {
  siteUrl: Astro.url.origin,
  path: "/about",
  defaultDescription: "About me — what I'm learning, building, and exploring.",
});
---

<Base
  title={seo.title}
  pageTitle={seo.ogTitle}
  description={seo.description}
  image={seo.ogImage}
  canonical={seo.canonical}
  robots={seo.robots}
  content={{ collection: "pages", id: page.data.id, slug: "about" }}
>
  <div class="about-page">
    <header class="about-header">
      <p class="about-eyebrow">Profile</p>
      <h1 class="about-title" {...page.edit.title}>
        {page.data.title}
      </h1>
    </header>

    <div class="about-content" {...page.edit.content}>
      {
        page.data.content ? (
          <PortableText value={page.data.content} />
        ) : (
          <p>Open /_emdash/admin to write your story.</p>
        )
      }
    </div>

    <aside class="about-sidebar">
      <div class="sidebar-card">
        <h3>Quick Facts</h3>
        <dl class="profile-list">
          <div>
            <dt>Studying / Focus</dt>
            <dd>Computer Science, Design, or your major</dd>
          </div>
          <div>
            <dt>Currently Building</dt>
            <dd>My first Cloudflare Worker at Build Night</dd>
          </div>
          <div>
            <dt>Rabbit Holes</dt>
            <dd>Systems, creative coding, open web</dd>
          </div>
          <div>
            <dt>Off the Clock</dt>
            <dd>Music, film, sketching, late-night side quests</dd>
          </div>
        </dl>
      </div>

      <div class="sidebar-card sidebar-card--hint">
        <h3>Make This Page Yours</h3>
        <p>
          Edit the bio sections on the left directly in{" "}
          <a href="/_emdash/admin">/_emdash/admin</a> (under <strong>Pages &rarr; About</strong>),
          or customize the Quick Facts card in <code>src/pages/about.astro</code>.
        </p>
      </div>
    </aside>
  </div>
</Base>

<style>
  .about-page {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-4xl);
    display: grid;
    grid-template-columns: 1.65fr 1fr;
    gap: var(--spacing-3xl);
  }

  .about-header {
    grid-column: 1 / -1;
    padding-bottom: var(--spacing-lg);
    border-bottom: 2px solid var(--color-bauhaus-ink);
  }

  .about-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-brand);
    margin-bottom: var(--spacing-xs);
  }

  .about-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-display);
    line-height: var(--leading-tight);
  }

  .about-content {
    font-size: var(--font-size-base);
    line-height: var(--leading-relaxed);
  }

  .about-content :global(p) {
    margin-bottom: 1.4em;
  }

  .about-content :global(h2) {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-heading);
    margin-top: 1.8em;
    margin-bottom: 0.5em;
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--color-border);
  }

  .about-content :global(h2:first-child) {
    margin-top: 0;
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    align-self: start;
  }

  .sidebar-card {
    background: var(--color-surface);
    border: 2px solid var(--color-bauhaus-ink);
    box-shadow: 6px 6px 0 var(--color-bauhaus-ink);
    padding: var(--spacing-xl);
  }

  .sidebar-card--hint {
    box-shadow: none;
    border-style: dashed;
  }

  .sidebar-card h3 {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-brand);
    margin-bottom: var(--spacing-md);
  }

  .profile-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .profile-list dt {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
    margin-bottom: 0.15rem;
  }

  .profile-list dd {
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .sidebar-card p {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: var(--leading-normal);
  }

  @media (max-width: 768px) {
    .about-page {
      grid-template-columns: 1fr;
    }
  }
</style>
