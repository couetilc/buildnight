---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projectsResult = await getEmDashCollection("projects", {
  orderBy: { published_at: "desc" },
  limit: 12,
});
if (projectsResult.error) {
  return new Response("Could not load the portfolio", { status: 500 });
}
const { entries: featuredProjects, cacheHint } = projectsResult;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base>
  <section class="hero-frame" aria-label="Bauhaus and Rothko composition">
    <div class="bauhaus-card">
      <div class="rothko-bauhaus-canvas" aria-hidden="true">
        <div class="rothko-field rothko-left"></div>
        <div class="rothko-field rothko-center"></div>
        <div class="rothko-field rothko-right"></div>
        <div class="bauhaus-bar"></div>
        <div class="bauhaus-circle"></div>
        <div class="bauhaus-triangle"></div>
      </div>
      <div class="bauhaus-legend">
        <div class="legend-item">
          <span class="swatch swatch-crimson"></span>
          <span>01 / Color Field</span>
        </div>
        <div class="legend-item">
          <span class="swatch swatch-ochre"></span>
          <span>02 / Form &amp; Grid</span>
        </div>
        <div class="legend-item">
          <span class="swatch swatch-ultramarine"></span>
          <span>03 / Your Voice</span>
        </div>
      </div>
    </div>
  </section>

  {
    featuredProjects.length > 0 ? (
      <section class="featured">
        <header class="section-header">
          <h2 class="section-title">Kaleidoscope of Vibes</h2>
          <span class="section-count">{featuredProjects.length} Archetypes</span>
        </header>
        <div class="projects-grid">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              summary={project.data.summary}
              featuredImage={project.data.featured_image}
              href={`/work/${project.id}`}
              client={project.data.client}
              year={project.data.year}
              edit={project.edit}
            />
          ))}
        </div>
      </section>
    ) : (
      <section class="empty-state">
        <div class="empty-card">
          <h2>Unseeded Canvas</h2>
          <p>Seed your database with 12 starter vibes.</p>
          <a href="/_emdash/admin" class="btn">
            Open /_emdash/admin &rarr;
          </a>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero-frame {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-2xl);
  }

  .bauhaus-card {
    border: 2px solid var(--color-bauhaus-ink);
    background: var(--color-surface);
    box-shadow: 8px 8px 0 var(--color-bauhaus-ink);
    overflow: hidden;
  }

  /* Unified Rothko color-field canvas with Bauhaus geometry layered inside */
  .rothko-bauhaus-canvas {
    position: relative;
    height: 210px;
    padding: 18px;
    background: #181312;
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.9fr;
    gap: 14px;
    overflow: hidden;
  }

  .rothko-field {
    height: 100%;
    border-radius: 6px;
    filter: blur(1.5px);
  }

  .rothko-left {
    background: radial-gradient(
      ellipse at 50% 48%,
      #d63a2f 0%,
      #a8201a 68%,
      #7c1612 100%
    );
    box-shadow: 0 0 26px rgba(214, 58, 47, 0.55);
  }

  .rothko-center {
    background: radial-gradient(
      ellipse at 50% 50%,
      #f0a824 0%,
      #d96b1f 72%,
      #a64214 100%
    );
    box-shadow: 0 0 24px rgba(240, 168, 36, 0.45);
  }

  .rothko-right {
    background: radial-gradient(
      ellipse at 50% 50%,
      #274675 0%,
      #182c4d 75%,
      #0f1b30 100%
    );
    box-shadow: 0 0 24px rgba(39, 70, 117, 0.5);
  }

  .bauhaus-bar {
    position: absolute;
    width: 140%;
    height: 7px;
    background: #161514;
    top: 50%;
    left: -20%;
    transform: rotate(-11deg);
  }

  .bauhaus-circle {
    position: absolute;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: #f6f1e7;
    border: 3px solid #161514;
    top: 50%;
    left: 42%;
    transform: translate(-50%, -50%);
    box-shadow: 5px 5px 0 #161514;
  }

  .bauhaus-triangle {
    position: absolute;
    bottom: 24px;
    right: 42px;
    width: 0;
    height: 0;
    border-left: 24px solid transparent;
    border-right: 24px solid transparent;
    border-bottom: 42px solid #e8a317;
    filter: drop-shadow(4px 4px 0 #161514);
  }

  .bauhaus-legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--color-bauhaus-ink);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .legend-item + .legend-item {
    border-left: 2px solid var(--color-bauhaus-ink);
  }

  .swatch {
    width: 12px;
    height: 12px;
    display: inline-block;
    border: 1px solid var(--color-bauhaus-ink);
    flex-shrink: 0;
  }

  .swatch-crimson {
    background: var(--color-rothko-crimson);
  }

  .swatch-ochre {
    background: var(--color-rothko-ochre);
  }

  .swatch-ultramarine {
    background: var(--color-rothko-ultramarine);
  }

  .featured {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-4xl);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--color-bauhaus-ink);
  }

  .section-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-heading);
  }

  .section-count {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }

  .empty-state {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0 var(--spacing-lg) var(--spacing-4xl);
  }

  .empty-card {
    text-align: center;
    padding: var(--spacing-3xl) var(--spacing-xl);
    background: var(--color-surface);
    border: 2px solid var(--color-bauhaus-ink);
    box-shadow: 8px 8px 0 var(--color-bauhaus-ink);
    max-width: 480px;
    margin: 0 auto;
  }

  .empty-card h2 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-xs);
  }

  .empty-card p {
    color: var(--color-muted);
    margin-bottom: var(--spacing-lg);
  }

  .btn {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .rothko-bauhaus-canvas {
      grid-template-columns: 1fr;
      height: 180px;
    }

    .bauhaus-legend {
      grid-template-columns: 1fr;
    }

    .legend-item + .legend-item {
      border-left: none;
      border-top: 2px solid var(--color-bauhaus-ink);
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
