---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projectsResult = await getEmDashCollection("projects", {
  orderBy: { published_at: "desc" },
  limit: 12,
});
if (projectsResult.error) {
  return new Response("Could not load the portfolio", { status: 500 });
}
const { entries: featuredProjects, cacheHint } = projectsResult;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base>
  <section class="hero-frame" aria-label="Rothko color fields with Bauhaus edgework">
    <div class="bauhaus-card">
      <div class="bauhaus-edge-rail bauhaus-edge-rail--top" aria-hidden="true">
        <span class="edge-tick"></span>
        <span class="edge-rule"></span>
        <span class="edge-stud edge-stud--circle"></span>
        <span class="edge-stud edge-stud--square"></span>
        <span class="edge-rule"></span>
        <span class="edge-tick"></span>
      </div>

      <div class="rothko-canvas" aria-hidden="true">
        <div class="bauhaus-corner bauhaus-corner--tl"></div>
        <div class="bauhaus-corner bauhaus-corner--tr"></div>
        <div class="bauhaus-corner bauhaus-corner--bl"></div>
        <div class="bauhaus-corner bauhaus-corner--br"></div>

        <div class="rothko-field rothko-red"></div>
        <div class="rothko-field rothko-orange"></div>
        <div class="rothko-field rothko-blue"></div>
      </div>

      <div class="bauhaus-legend">
        <div class="legend-item">
          <span class="swatch swatch-crimson"></span>
          <span>01 / Color Field</span>
        </div>
        <div class="legend-item">
          <span class="swatch swatch-ochre"></span>
          <span>02 / Form &amp; Grid</span>
        </div>
        <div class="legend-item">
          <span class="swatch swatch-ultramarine"></span>
          <span>03 / Your Voice</span>
        </div>
      </div>
    </div>
  </section>

  {
    featuredProjects.length > 0 ? (
      <section class="featured">
        <header class="section-header">
          <h2 class="section-title">Kaleidoscope of Vibes</h2>
          <span class="section-count">{featuredProjects.length} Archetypes</span>
        </header>
        <div class="projects-grid">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              summary={project.data.summary}
              featuredImage={project.data.featured_image}
              href={`/work/${project.id}`}
              client={project.data.client}
              year={project.data.year}
              edit={project.edit}
            />
          ))}
        </div>
      </section>
    ) : (
      <section class="empty-state">
        <div class="empty-card">
          <h2>Unseeded Canvas</h2>
          <p>Seed your database with 12 starter vibes.</p>
          <a href="/_emdash/admin" class="btn">
            Open /_emdash/admin &rarr;
          </a>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero-frame {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-2xl);
  }

  .bauhaus-card {
    border: 2px solid var(--color-bauhaus-ink);
    background: var(--color-surface);
    box-shadow: 8px 8px 0 var(--color-bauhaus-ink);
    overflow: hidden;
  }

  /* Subtle Bauhaus architectural edgework framing the Rothko canvas */
  .bauhaus-edge-rail {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    background: var(--color-surface);
    border-bottom: 2px solid var(--color-bauhaus-ink);
  }

  .edge-tick {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--color-bauhaus-ink);
    flex-shrink: 0;
  }

  .edge-rule {
    flex: 1;
    height: 1.5px;
    background: var(--color-bauhaus-ink);
    opacity: 0.35;
  }

  .edge-stud {
    flex-shrink: 0;
  }

  .edge-stud--circle {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-rothko-crimson);
  }

  .edge-stud--square {
    width: 8px;
    height: 8px;
    background: var(--color-rothko-ochre);
  }

  /* Pure Rothko color-field expanse: red, orange, blue */
  .rothko-canvas {
    position: relative;
    height: 205px;
    padding: 22px 26px;
    background:
      radial-gradient(ellipse at 18% 50%, rgba(184, 41, 33, 0.35), transparent 60%),
      radial-gradient(ellipse at 52% 50%, rgba(217, 93, 36, 0.28), transparent 60%),
      radial-gradient(ellipse at 85% 50%, rgba(29, 53, 87, 0.38), transparent 60%),
      #161110;
    display: grid;
    grid-template-columns: 1.15fr 1.05fr 0.95fr;
    gap: 18px;
    overflow: hidden;
  }

  /* Fine Bauhaus corner L-brackets along the perimeter */
  .bauhaus-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(246, 241, 231, 0.55);
    border-style: solid;
    pointer-events: none;
    z-index: 2;
  }

  .bauhaus-corner--tl {
    top: 8px;
    left: 8px;
    border-width: 2px 0 0 2px;
  }

  .bauhaus-corner--tr {
    top: 8px;
    right: 8px;
    border-width: 2px 2px 0 0;
  }

  .bauhaus-corner--bl {
    bottom: 8px;
    left: 8px;
    border-width: 0 0 2px 2px;
  }

  .bauhaus-corner--br {
    bottom: 8px;
    right: 8px;
    border-width: 0 2px 2px 0;
  }

  .rothko-field {
    position: relative;
    height: 100%;
    border-radius: 10px;
    filter: blur(3.5px);
  }

  .rothko-red {
    background:
      radial-gradient(ellipse at 48% 42%, #ec4638 0%, #c6281f 56%, #851510 92%, rgba(90, 14, 10, 0.7) 100%);
    box-shadow:
      0 0 38px rgba(230, 62, 48, 0.62),
      inset 0 0 28px rgba(255, 130, 105, 0.28);
  }

  .rothko-orange {
    background:
      radial-gradient(ellipse at 50% 48%, #f8b22d 0%, #e06d1f 58%, #9e3910 92%, rgba(110, 38, 12, 0.7) 100%);
    box-shadow:
      0 0 38px rgba(244, 152, 36, 0.54),
      inset 0 0 26px rgba(255, 214, 120, 0.28);
  }

  .rothko-blue {
    background:
      radial-gradient(ellipse at 52% 48%, #355fa0 0%, #1f3a68 58%, #11203d 92%, rgba(12, 23, 46, 0.75) 100%);
    box-shadow:
      0 0 38px rgba(53, 95, 160, 0.58),
      inset 0 0 26px rgba(120, 170, 240, 0.22);
  }

  .bauhaus-legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--color-bauhaus-ink);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .legend-item + .legend-item {
    border-left: 2px solid var(--color-bauhaus-ink);
  }

  .swatch {
    width: 12px;
    height: 12px;
    display: inline-block;
    border: 1px solid var(--color-bauhaus-ink);
    flex-shrink: 0;
  }

  .swatch-crimson {
    background: var(--color-rothko-crimson);
  }

  .swatch-ochre {
    background: var(--color-rothko-ochre);
  }

  .swatch-ultramarine {
    background: var(--color-rothko-ultramarine);
  }

  .featured {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-4xl);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--color-bauhaus-ink);
  }

  .section-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-heading);
  }

  .section-count {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }

  .empty-state {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0 var(--spacing-lg) var(--spacing-4xl);
  }

  .empty-card {
    text-align: center;
    padding: var(--spacing-3xl) var(--spacing-xl);
    background: var(--color-surface);
    border: 2px solid var(--color-bauhaus-ink);
    box-shadow: 8px 8px 0 var(--color-bauhaus-ink);
    max-width: 480px;
    margin: 0 auto;
  }

  .empty-card h2 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-xs);
  }

  .empty-card p {
    color: var(--color-muted);
    margin-bottom: var(--spacing-lg);
  }

  .btn {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .rothko-canvas {
      grid-template-columns: 1fr;
      height: 180px;
    }

    .bauhaus-legend {
      grid-template-columns: 1fr;
    }

    .legend-item + .legend-item {
      border-left: none;
      border-top: 2px solid var(--color-bauhaus-ink);
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
