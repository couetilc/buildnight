---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projectsResult = await getEmDashCollection("projects", {
  orderBy: { published_at: "desc" },
  limit: 12,
});
if (projectsResult.error) {
  return new Response("Could not load the portfolio", { status: 500 });
}
const { entries: featuredProjects, cacheHint } = projectsResult;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base>
  <section class="hero-frame" aria-label="Bauhaus and Rothko composition">
    <div class="rothko-bauhaus-stage">
      <div class="rothko-stack">
        <div class="rothko-field rothko-top"></div>
        <div class="rothko-field rothko-middle"></div>
        <div class="rothko-field rothko-bottom"></div>
      </div>
      <div class="bauhaus-composition">
        <div class="bauhaus-grid-cell cell-a">
          <div class="bauhaus-disc"></div>
        </div>
        <div class="bauhaus-grid-cell cell-b">
          <div class="bauhaus-pillar"></div>
          <div class="bauhaus-wedge"></div>
        </div>
        <div class="bauhaus-grid-cell cell-c">
          <span class="cell-index">I &middot; II &middot; III</span>
        </div>
      </div>
    </div>
  </section>

  {
    featuredProjects.length > 0 ? (
      <section class="featured">
        <header class="section-header">
          <h2 class="section-title">Kaleidoscope of Vibes</h2>
          <span class="section-count">{featuredProjects.length} Archetypes</span>
        </header>
        <div class="projects-grid">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              summary={project.data.summary}
              featuredImage={project.data.featured_image}
              href={`/work/${project.id}`}
              client={project.data.client}
              year={project.data.year}
              edit={project.edit}
            />
          ))}
        </div>
      </section>
    ) : (
      <section class="empty-state">
        <div class="empty-card">
          <h2>Unseeded Canvas</h2>
          <p>Seed your database with 12 starter vibes.</p>
          <a href="/_emdash/admin" class="btn">
            Open /_emdash/admin &rarr;
          </a>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero-frame {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-2xl);
  }

  .rothko-bauhaus-stage {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    min-height: 320px;
    border: 2px solid var(--color-bauhaus-ink);
    background: #181312;
    box-shadow: 8px 8px 0 var(--color-bauhaus-ink);
    overflow: hidden;
  }

  .rothko-stack {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-right: 2px solid var(--color-bauhaus-ink);
  }

  .rothko-field {
    width: 100%;
    border-radius: 6px;
    filter: blur(1.2px);
  }

  .rothko-top {
    flex: 1.3;
    background: radial-gradient(
      ellipse at 50% 45%,
      #d63a2f 0%,
      #a8201a 68%,
      #7c1612 100%
    );
    box-shadow: 0 0 24px rgba(214, 58, 47, 0.5);
  }

  .rothko-middle {
    flex: 0.95;
    background: radial-gradient(
      ellipse at 50% 50%,
      #f0a824 0%,
      #d96b1f 72%,
      #a64214 100%
    );
    box-shadow: 0 0 22px rgba(240, 168, 36, 0.4);
  }

  .rothko-bottom {
    flex: 0.8;
    background: radial-gradient(
      ellipse at 50% 50%,
      #274675 0%,
      #182c4d 75%,
      #0f1b30 100%
    );
    box-shadow: 0 0 20px rgba(39, 70, 117, 0.45);
  }

  .bauhaus-composition {
    display: grid;
    grid-template-rows: 1fr 1fr auto;
    background: var(--color-surface);
  }

  .bauhaus-grid-cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-lg);
    overflow: hidden;
  }

  .cell-a {
    border-bottom: 2px solid var(--color-bauhaus-ink);
    background: #f6f1e7;
  }

  .bauhaus-disc {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--color-rothko-crimson);
    border: 3px solid #161514;
    box-shadow: 5px 5px 0 #161514;
  }

  .cell-b {
    border-bottom: 2px solid var(--color-bauhaus-ink);
    background: var(--color-rothko-ultramarine);
    gap: 18px;
  }

  .bauhaus-pillar {
    width: 24px;
    height: 84px;
    background: #f6f1e7;
    border: 2px solid #161514;
    transform: rotate(-18deg);
  }

  .bauhaus-wedge {
    width: 0;
    height: 0;
    border-left: 32px solid transparent;
    border-right: 32px solid transparent;
    border-bottom: 56px solid var(--color-rothko-ochre);
    filter: drop-shadow(4px 4px 0 #161514);
  }

  .cell-c {
    padding: var(--spacing-sm) var(--spacing-md);
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
  }

  .featured {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-4xl);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--color-bauhaus-ink);
  }

  .section-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-heading);
  }

  .section-count {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }

  .empty-state {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0 var(--spacing-lg) var(--spacing-4xl);
  }

  .empty-card {
    text-align: center;
    padding: var(--spacing-3xl) var(--spacing-xl);
    background: var(--color-surface);
    border: 2px solid var(--color-bauhaus-ink);
    box-shadow: 8px 8px 0 var(--color-bauhaus-ink);
    max-width: 480px;
    margin: 0 auto;
  }

  .empty-card h2 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-xs);
  }

  .empty-card p {
    color: var(--color-muted);
    margin-bottom: var(--spacing-lg);
  }

  .btn {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .rothko-bauhaus-stage {
      grid-template-columns: 1fr;
    }

    .rothko-stack {
      min-height: 220px;
      border-right: none;
      border-bottom: 2px solid var(--color-bauhaus-ink);
    }

    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
