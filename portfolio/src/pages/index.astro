---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";

const [settings, projectsResult] = await Promise.all([
  getSiteSettings(),
  getEmDashCollection("projects", {
    orderBy: { published_at: "desc" },
    limit: 6,
  }),
]);
if (projectsResult.error) {
  return new Response("Could not load the portfolio", { status: 500 });
}
const { entries: featuredProjects, cacheHint } = projectsResult;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base>
  <section class="hero-frame">
    <div class="bauhaus-grid">
      <div class="hero-copy">
        <div class="bauhaus-kicker">
          <span class="kicker-dot"></span>
          <span>WEIMAR 1919 &times; NEW YORK 1958 &times; CLOUDFLARE BUILD NIGHT</span>
        </div>
        <h1 class="hero-title">{settings?.title || "What's your vibe?"}</h1>
        <p class="hero-tagline">
          {
            settings?.tagline ||
              "This corner of the internet belongs to you. Start from Bauhaus geometry and Rothko color fields—then reshape every pixel in Part 2."
          }
        </p>
        <div class="bauhaus-legend">
          <div class="legend-item">
            <span class="swatch swatch-crimson"></span>
            <span>01 / Color Field</span>
          </div>
          <div class="legend-item">
            <span class="swatch swatch-ochre"></span>
            <span>02 / Form &amp; Grid</span>
          </div>
          <div class="legend-item">
            <span class="swatch swatch-ultramarine"></span>
            <span>03 / Your Voice</span>
          </div>
        </div>
      </div>

      <div class="rothko-bauhaus-canvas" aria-hidden="true">
        <div class="rothko-field rothko-top"></div>
        <div class="rothko-field rothko-middle"></div>
        <div class="rothko-field rothko-bottom"></div>
        <div class="bauhaus-circle"></div>
        <div class="bauhaus-bar"></div>
        <div class="bauhaus-triangle"></div>
      </div>
    </div>
  </section>

  {
    featuredProjects.length > 0 ? (
      <section class="featured">
        <header class="section-header">
          <div>
            <p class="section-eyebrow">Inspiration Palette</p>
            <h2 class="section-title">A Kaleidoscope of Vibes</h2>
          </div>
          <a href="/work" class="section-link">
            Explore all vibes &rarr;
          </a>
        </header>
        <div class="projects-grid">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              summary={project.data.summary}
              featuredImage={project.data.featured_image}
              href={`/work/${project.id}`}
              client={project.data.client}
              year={project.data.year}
              edit={project.edit}
            />
          ))}
        </div>
      </section>
    ) : (
      <section class="empty-state">
        <div class="empty-card">
          <p class="empty-eyebrow">Database Unseeded</p>
          <h2>Seed your Kaleidoscope of Vibes</h2>
          <p>
            Open the EmDash admin panel to create your account and seed your D1
            database with six starter aesthetics.
          </p>
          <a href="/_emdash/admin" class="btn">
            Open /_emdash/admin &rarr;
          </a>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero-frame {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
  }

  .bauhaus-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    border: 2px solid var(--color-bauhaus-ink);
    background: var(--color-surface);
    box-shadow: 10px 10px 0 var(--color-bauhaus-ink);
    overflow: hidden;
  }

  .hero-copy {
    padding: var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-xl);
    border-right: 2px solid var(--color-bauhaus-ink);
  }

  .bauhaus-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .kicker-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-rothko-crimson);
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    font-weight: var(--font-weight-display);
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
  }

  .hero-tagline {
    font-size: var(--font-size-xl);
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-style: italic;
    line-height: 1.45;
    max-width: 34ch;
  }

  .bauhaus-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    border-top: 1.5px solid var(--color-bauhaus-ink);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .swatch {
    width: 12px;
    height: 12px;
    display: inline-block;
    border: 1px solid var(--color-bauhaus-ink);
  }

  .swatch-crimson {
    background: var(--color-rothko-crimson);
  }

  .swatch-ochre {
    background: var(--color-rothko-ochre);
  }

  .swatch-ultramarine {
    background: var(--color-rothko-ultramarine);
  }

  /* Rothko color fields + Bauhaus geometric overlay */
  .rothko-bauhaus-canvas {
    position: relative;
    min-height: 420px;
    padding: 24px;
    background: #1c1614;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    overflow: hidden;
  }

  .rothko-field {
    width: 100%;
    border-radius: 6px;
    filter: blur(1.5px);
    transition: transform var(--transition-slow);
  }

  .rothko-top {
    flex: 1.25;
    background: radial-gradient(
      ellipse at 50% 45%,
      #d63a2f 0%,
      #a8201a 68%,
      #7c1612 100%
    );
    box-shadow: 0 0 28px rgba(214, 58, 47, 0.55);
  }

  .rothko-middle {
    flex: 0.95;
    background: radial-gradient(
      ellipse at 50% 50%,
      #f0a824 0%,
      #d96b1f 72%,
      #a64214 100%
    );
    box-shadow: 0 0 26px rgba(240, 168, 36, 0.45);
  }

  .rothko-bottom {
    flex: 0.85;
    background: radial-gradient(
      ellipse at 50% 50%,
      #274675 0%,
      #182c4d 75%,
      #0f1b30 100%
    );
    box-shadow: 0 0 24px rgba(39, 70, 117, 0.5);
  }

  .bauhaus-circle {
    position: absolute;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background: #f6f1e7;
    border: 3px solid #161514;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 6px 6px 0 #161514;
  }

  .bauhaus-bar {
    position: absolute;
    width: 180%;
    height: 8px;
    background: #161514;
    top: 50%;
    left: -40%;
    transform: rotate(-28deg);
  }

  .bauhaus-triangle {
    position: absolute;
    bottom: 34px;
    right: 34px;
    width: 0;
    height: 0;
    border-left: 26px solid transparent;
    border-right: 26px solid transparent;
    border-bottom: 45px solid #e8a317;
    filter: drop-shadow(4px 4px 0 #161514);
  }

  .featured {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-4xl);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--color-bauhaus-ink);
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-brand);
    margin-bottom: var(--spacing-xs);
  }

  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-heading);
  }

  .section-link {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .section-link:hover {
    color: var(--color-text);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }

  .empty-state {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0 var(--spacing-lg) var(--spacing-4xl);
  }

  .empty-card {
    text-align: center;
    padding: var(--spacing-3xl) var(--spacing-xl);
    background: var(--color-surface);
    border: 2px solid var(--color-bauhaus-ink);
    box-shadow: 8px 8px 0 var(--color-bauhaus-ink);
    max-width: 560px;
    margin: 0 auto;
  }

  .empty-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-brand);
    margin-bottom: var(--spacing-sm);
  }

  .empty-card h2 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-sm);
  }

  .empty-card p {
    color: var(--color-muted);
    margin-bottom: var(--spacing-lg);
  }

  .btn {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    border-radius: var(--radius);
    transition: opacity var(--transition-fast);
  }

  .btn:hover {
    opacity: 0.85;
  }

  @media (max-width: 960px) {
    .bauhaus-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      border-right: none;
      border-bottom: 2px solid var(--color-bauhaus-ink);
      padding: var(--spacing-2xl);
    }

    .rothko-bauhaus-canvas {
      min-height: 300px;
    }

    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .section-header {
      flex-direction: column;
      gap: var(--spacing-sm);
      align-items: flex-start;
    }
  }
</style>
