---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
  title?: string;
  pageTitle?: string | null;
  description?: string | null;
  image?: string | null;
  canonical?: string | null;
  robots?: string | null;
  type?: "website" | "article";
  content?: { collection: string; id: string; slug?: string | null };
}

const {
  title,
  pageTitle,
  description,
  image,
  canonical,
  robots,
  type = "website",
  content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
  getSiteSettingsWithCacheHint(),
  getMenuWithCacheHint("primary"),
]);
const settings = settingsResult.data;
const menu = menuResult.data;
if (Astro.cache?.enabled) {
  Astro.cache.set(settingsResult.cacheHint);
  Astro.cache.set(menuResult.cacheHint);
}

const siteTitle = settings?.title || "What's your vibe?";
const separator = settings?.seo?.titleSeparator || " — ";
const fullTitle = !title
  ? siteTitle
  : title === siteTitle ||
      title.endsWith(` — ${siteTitle}`) ||
      title.endsWith(` | ${siteTitle}`)
    ? title
    : `${title}${separator}${siteTitle}`;
const siteDescription =
  settings?.tagline || "Pick a direction. Make it yours.";
const siteLogo = settings?.logo?.url ? settings.logo : null;
const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, Astro.url.origin).href;

const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: type,
  title: fullTitle,
  pageTitle: pageTitle ?? title ?? siteTitle,
  description: description || siteDescription,
  canonical: canonicalUrl,
  image,
  content,
  seo: { ogImage: image, robots },
  siteName: siteTitle,
});

const isLoggedIn = Boolean(Astro.locals.user);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <EmDashHead page={pageCtx} />
    <Font cssVariable="--font-brutalist" preload />
    <Font cssVariable="--font-heading" preload />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteTitle} RSS Feed`}
      href="/rss.xml"
    />
    <script is:inline>
      (function () {
        var c = document.cookie;
        var i = c.indexOf("theme=");
        var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
        if (theme === "dark" || theme === "light") {
          document.documentElement.classList.add(theme);
        }
      })();
    </script>
  </head>
  <body>
    <EmDashBodyStart page={pageCtx} />
    <header class="site-header">
      <div class="masthead">
        <a href="/" class="site-title">
          {
            siteLogo ? (
              <img
                src={siteLogo.url}
                alt={siteLogo.alt || siteTitle}
                class="site-logo-img"
              />
            ) : (
              <span>{siteTitle}</span>
            )
          }
        </a>
      </div>
      <nav class="nav">
        <div class="bauhaus-mark" aria-hidden="true">
          <span class="mark-circle"></span>
          <span class="mark-square"></span>
          <span class="mark-triangle"></span>
        </div>
        <div class="nav-links">
          {
            menu?.items.map((item) => (
              <a
                href={item.url}
                target={item.target}
                rel={
                  item.target === "_blank" ? "noopener noreferrer" : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
          <a href="/_emdash/admin" class="nav-admin">
            {isLoggedIn ? "Admin" : "Admin"}
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <span class="footer-logo">{siteTitle}</span>
        <div class="theme-switcher">
          <button
            type="button"
            class="theme-btn"
            data-theme="light"
            aria-pressed="false"
            aria-label="Light mode">Light</button
          >
          <button
            type="button"
            class="theme-btn"
            data-theme="dark"
            aria-pressed="false"
            aria-label="Dark mode">Dark</button
          >
          <button
            type="button"
            class="theme-btn"
            data-theme="system"
            aria-pressed="false"
            aria-label="System theme">System</button
          >
        </div>
      </div>
    </footer>
    <EmDashBodyEnd page={pageCtx} />

    <script>
      const THEME_REGEX = /theme=([^;]+)/;
      const themeBtns =
        document.querySelectorAll<HTMLButtonElement>(".theme-btn");
      const root = document.documentElement;

      function setTheme(theme: string) {
        if (theme !== "light" && theme !== "dark" && theme !== "system") {
          theme = "system";
        }
        const secure = location.protocol === "https:" ? "; Secure" : "";
        if (theme === "system") {
          document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
          root.classList.remove("light", "dark");
        } else {
          document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
          root.classList.remove("light", "dark");
          root.classList.add(theme);
        }
        updateActiveBtn(theme);
      }

      function updateActiveBtn(theme: string) {
        themeBtns.forEach((btn) => {
          const active = btn.dataset.theme === theme;
          btn.classList.toggle("active", active);
          btn.setAttribute("aria-pressed", String(active));
        });
      }

      function getStoredTheme(): string {
        const match = document.cookie.match(THEME_REGEX);
        return match ? match[1] : "system";
      }

      const storedTheme = getStoredTheme();
      setTheme(storedTheme);

      themeBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          setTheme(btn.dataset.theme || "system");
        });
      });
    </script>

    <style is:global>
      @layer base;

      @layer base {
        *,
        *::before,
        *::after {
          box-sizing: border-box;
          margin: 0;
          padding: 0;
        }

        @supports (color: light-dark(#000, #fff)) {
          :root.light {
            color-scheme: light;
          }

          :root.dark {
            color-scheme: dark;
          }
        }

        html {
          scroll-behavior: smooth;
        }

        body {
          font-family: var(--font-body);
          font-size: var(--font-size-base);
          line-height: var(--leading-normal);
          color: var(--color-text);
          background: var(--color-bg);
          -webkit-font-smoothing: antialiased;
          min-height: 100vh;
        }

        a {
          color: currentColor;
        }

        img {
          max-width: 100%;
          height: auto;
          display: block;
        }

        h1,
        h2,
        h3,
        h4 {
          font-family: var(--font-heading);
          font-weight: var(--font-weight-heading);
          line-height: var(--leading-snug);
        }

        h1 {
          font-size: var(--font-size-4xl);
        }

        h2 {
          font-size: var(--font-size-2xl);
        }

        h3 {
          font-size: var(--font-size-xl);
        }
      }
    </style>

    <style>
      .site-header {
        max-width: var(--wide-width);
        margin: 0 auto;
        padding: var(--spacing-xl) var(--spacing-lg) 0;
      }

      .masthead {
        padding-bottom: var(--spacing-md);
        border-bottom: 2px solid var(--color-bauhaus-ink);
      }

      .site-title {
        display: block;
        font-family: var(--font-brutalist), system-ui, -apple-system, sans-serif;
        font-size: clamp(3.5rem, 8.8vw, 7.25rem);
        font-weight: 700;
        line-height: 0.92;
        text-decoration: none;
        letter-spacing: -0.045em;
        text-transform: uppercase;
      }

      .site-logo-img {
        height: 56px;
        width: auto;
        display: block;
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-md) 0;
        border-bottom: 2px solid var(--color-bauhaus-ink);
      }

      .bauhaus-mark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .mark-circle {
        width: 13px;
        height: 13px;
        border-radius: 999px;
        background: var(--color-rothko-crimson);
        display: inline-block;
      }

      .mark-square {
        width: 12px;
        height: 12px;
        background: var(--color-rothko-ochre);
        display: inline-block;
      }

      .mark-triangle {
        width: 0;
        height: 0;
        border-left: 7px solid transparent;
        border-right: 7px solid transparent;
        border-bottom: 12px solid var(--color-rothko-ultramarine);
        display: inline-block;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: var(--spacing-xl);
        font-size: var(--font-size-xs);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
      }

      .nav-links a {
        text-decoration: none;
        color: var(--color-muted);
        transition: color var(--transition-fast);
      }

      .nav-links a:hover {
        color: var(--color-text);
      }

      .nav-admin {
        padding: 0.25rem 0.6rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
      }

      main {
        min-height: calc(100vh - 240px);
      }

      .site-footer {
        max-width: var(--wide-width);
        margin: 0 auto;
        padding: var(--spacing-2xl) var(--spacing-lg);
        border-top: 2px solid var(--color-bauhaus-ink);
      }

      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .footer-logo {
        font-family: var(--font-brutalist), system-ui, sans-serif;
        font-size: var(--font-size-base);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: -0.02em;
      }

      .theme-switcher {
        display: flex;
        gap: var(--spacing-xs);
      }

      .theme-btn {
        background: transparent;
        border: 1px solid var(--color-border);
        color: var(--color-muted);
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        padding: var(--spacing-xs) var(--spacing-sm);
        border-radius: var(--radius);
        cursor: pointer;
        transition: all var(--transition-fast);
      }

      .theme-btn:hover {
        color: var(--color-text);
        border-color: var(--color-text);
      }

      .theme-btn.active {
        background: var(--color-surface);
        color: var(--color-text);
        border-color: var(--color-brand);
      }

      @media (max-width: 640px) {
        .nav {
          flex-direction: column;
          gap: var(--spacing-md);
          align-items: flex-start;
        }

        .nav-links {
          flex-wrap: wrap;
        }

        .footer-content {
          flex-direction: column;
          gap: var(--spacing-md);
          align-items: flex-start;
        }
      }
    </style>
  </body>
</html>
