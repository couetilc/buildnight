        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "About This Space",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "_key": "ab0",
              "children": [
                {
                  "_type": "span",
                  "_key": "ab1",
                  "text": "Welcome to your personal corner of the internet, running on a Cloudflare Worker and backed by a D1 database. You deployed this site by hand—no black boxes, no algorithmic feed."
                }
              ]
            },
            {
              "_type": "block",
              "style": "h2",
              "_key": "ab2",
              "children": [
                {
                  "_type": "span",
                  "_key": "ab3",
                  "text": "Make It Yours in Part 2"
                }
              ]
            },
            {
              "_type": "block",
              "style": "normal",
              "_key": "ab4",
              "children": [
                {
                  "_type": "span",
                  "_key": "ab5",
                  "text": "The starter design blends Weimar-era Bauhaus geometry with Mark Rothko's luminous color fields. Browse the seeded vibes on the home page for inspiration, edit this copy in /_emdash/admin, or overhaul src/styles/theme.css with your coding agent in Part 2."
                }
              ]
            }
          ]
        }
      }
    ],
