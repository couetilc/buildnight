      {
        "id": "bauhaus-rothko",
        "slug": "bauhaus-rothko",
        "status": "published",
        "data": {
          "title": "Bauhaus × Rothko",
          "client": "Color Field & Constructivism",
          "year": "1919 / 1958",
          "summary": "Architectural Bauhaus geometry intersecting soft, luminous Rothko pigment fields on warm archival paper.",
          "featured_image": {
            "id": "media-bauhaus-rothko",
            "src": "/vibes/bauhaus-rothko.svg",
            "alt": "Stacked crimson, ochre, and ultramarine Rothko color fields crossed by Bauhaus geometric forms",
            "width": 1200,
            "height": 900
          },
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "_key": "br0",
              "children": [
                {
                  "_type": "span",
                  "_key": "br1",
                  "text": "What happens when strict Weimar grid discipline meets emotional color fields? Heavy 2px structural borders hold the page together while deep crimson, saffron ochre, and midnight ultramarine glow from within."
                }
              ]
            },
            {
              "_type": "block",
              "style": "h2",
              "_key": "br2",
              "children": [
                {
                  "_type": "span",
                  "_key": "br3",
                  "text": "How to steal this vibe"
                }
              ]
            },
            {
              "_type": "block",
              "style": "normal",
              "_key": "br4",
              "children": [
                {
                  "_type": "span",
                  "_key": "br5",
                  "text": "Pair high-contrast serif headings with crisp monospace metadata labels, exposed grid borders, and warm paper backgrounds (#f6f1e7)."
                }
              ]
            }
          ]
        },
        "taxonomies": {
          "tag": [
            "geometric",
            "color-field"
          ]
        }
      },
